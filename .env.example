# Local origin. Live payments require a public HTTPS origin.
APP_URL=http://127.0.0.1:4173
PORT=4173
HOST=127.0.0.1

# Configure actual secrets privately; never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# USD recurring prices: $19/month and $190/year.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Enable invoices, payment method updates and cancellation in this configuration.
# Disable price/quantity changes and discounts.
STRIPE_PORTAL_CONFIGURATION_ID=

# Optional first-run owner account. Remove these values after creating it.
# Use a unique password of at least 16 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
